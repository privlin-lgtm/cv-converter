# Copy to server/.env and fill in the values. Never commit server/.env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Postgres connection URLs for the cv_converter_dev and cv_converter_test databases.
DATABASE_URL=
DATABASE_URL_TEST=
PORT=3001
# A long random string that keys the hash of each client's IP address for the rate limit.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
# Requests allowed per client IP in each window. The defaults are 10 conversions and 30 ratings per 60 minutes.
RATE_LIMIT_CONVERT=10
RATE_LIMIT_RATINGS=30
RATE_LIMIT_WINDOW_MINUTES=60
# Proxies in front of the API whose X-Forwarded-For entry is trusted. 0 locally, 1 on Vercel.
TRUST_PROXY_HOPS=0
